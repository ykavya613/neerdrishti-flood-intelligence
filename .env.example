# =========================================================
# NeerDrishti Environment Configuration
# =========================================================

# Primary LLM Provider: 'llama' or 'openai_compatible'
LLM_PROVIDER=llama

# Meta Llama / OpenAI-Compatible Endpoint Configuration
# For local development with Ollama:
#   1. Install Ollama: https://ollama.com
#   2. Pull Llama: ollama run llama3.2:3b
OPENAI_COMPATIBLE_BASE_URL=http://127.0.0.1:11434/v1
OPENAI_COMPATIBLE_API_KEY=ollama
OPENAI_COMPATIBLE_MODEL=llama3.2:3b

# Telemetry Refresh Settings (Minutes)
LIVE_DATA_REFRESH_MINUTES=30


